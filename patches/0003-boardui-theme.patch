diff --git a/public/styles/boardui.css b/public/styles/boardui.css
new file mode 100644
index 0000000000000000000000000000000000000000..9311c94de36d2ed5a582957ca77126e32981c924
--- /dev/null
+++ b/public/styles/boardui.css
@@ -0,0 +1,274 @@
+/* BoardUI visual language, adapted to OpenProject's existing components and navigation. */
+@font-face {
+  font-family: "Inter";
+  src: url("../fonts/inter/InterVariable.woff2?v=1") format("woff2");
+  font-weight: 100 900;
+  font-style: normal;
+  font-display: swap;
+}
+
+body.theme-core_design {
+  --board-surface: #fff;
+  --board-ground: #f7f7f7;
+  --board-hover: #ebebeb;
+  --board-ink: #141414;
+  --board-muted: #707070;
+  --board-line: #ebebeb;
+  --board-accent: #246fea;
+  --board-on-accent: #fff;
+  --board-accent-hover: #1765ed;
+  --board-selected: #e7efff;
+  --board-float-shadow: 0 1px 0 #00000005, 0 1px 12px #0000000f, 0 0 1px #00000052;
+  --body-font-family: "Inter", "Segoe UI", sans-serif;
+  --body-font-color: var(--board-ink);
+  --body-font-size: 14px;
+  --fgColor-default: var(--board-ink);
+  --fgColor-muted: var(--board-muted);
+  --fgColor-accent: #1765dd;
+  --bgColor-default: var(--board-surface);
+  --bgColor-muted: var(--board-ground);
+  --bgColor-inset: var(--board-ground);
+  --bgColor-neutral-muted: var(--board-hover);
+  --borderColor-default: var(--board-line);
+  --borderColor-muted: var(--board-line);
+  --borderColor-accent-emphasis: var(--board-accent);
+  --borderRadius-small: 6px;
+  --borderRadius-medium: 10px;
+  --borderRadius-large: 16px;
+  --borderRadius-xlarge: 24px;
+  --header-bg-color: var(--board-ground);
+  --header-item-font-color: var(--board-ink);
+  --header-item-font-hover-color: var(--board-ink);
+  --header-border-bottom-color: transparent;
+  --main-menu-bg-color: var(--board-ground);
+  --main-menu-font-color: var(--board-muted);
+  --main-menu-selected-font-color: var(--board-on-accent);
+  --main-menu-bg-selected-background: var(--board-accent);
+  --main-menu-bg-selected-border: transparent;
+  --main-menu-border-color: var(--board-line);
+  --main-menu-font-size: 14px;
+  --main-menu-item-height: 38px;
+  --control-transparent-bgColor-hover: var(--board-hover);
+  --control-transparent-bgColor-selected: var(--board-selected);
+  --control-bgColor-rest: var(--board-surface);
+  --control-borderColor-rest: #dedede;
+  --control-checked-bgColor-rest: var(--board-accent);
+  --control-checked-bgColor-hover: var(--board-accent-hover);
+  --focus-outlineColor: var(--board-accent);
+  --button-default-bgColor-rest: var(--board-surface);
+  --button-default-bgColor-hover: var(--board-ground);
+  --button-default-bgColor-active: var(--board-hover);
+  --button-default-bgColor-selected: var(--board-hover);
+  --button-default-borderColor-rest: var(--board-line);
+  --button-primary-bgColor-rest: var(--board-accent);
+  --button-primary-bgColor-hover: var(--board-accent-hover);
+  --button-primary-bgColor-active: #1452c7;
+  --button-primary-borderColor-rest: #ffffff38;
+  --button-primary-borderColor-hover: #ffffff50;
+  --button-primary-fgColor-rest: var(--board-on-accent);
+  --button-outline-fgColor-rest: #1765dd;
+  --button--background-color: var(--board-surface);
+  --button--primary-background-color: var(--board-accent);
+  --button--primary-border-color: var(--board-accent);
+  --button--primary-background-hover-color: var(--board-accent-hover);
+  --accent-color: var(--board-accent);
+  --link-text-color: #1765dd;
+  --overlay-bgColor: var(--board-surface);
+  --dashboard-bgColor: var(--board-surface);
+  font-family: var(--body-font-family);
+  font-variant-numeric: tabular-nums;
+  color: var(--board-ink);
+  background: var(--board-surface);
+}
+
+body.theme-core_design[data-color-mode="dark"] {
+  --board-surface: #171717;
+  --board-ground: #212121;
+  --board-hover: #303030;
+  --board-ink: #f5f5f5;
+  --board-muted: #b1b1b1;
+  --board-line: #363636;
+  --board-selected: #203454;
+  --board-accent: #5095ff;
+  --board-on-accent: #141414;
+  --board-accent-hover: #347eee;
+  --fgColor-accent: #80b3ff;
+  --link-text-color: #80b3ff;
+  --control-borderColor-rest: #484848;
+  --board-float-shadow: 0 1px 12px #00000026, 0 0 1px #ffffff40;
+  color-scheme: dark;
+}
+
+body.theme-core_design :is(input, select, textarea, .Button, .button, .FormControl-label) {
+  font-family: var(--body-font-family);
+}
+body.theme-core_design :is(h1, h2, h3, .op-subheader--title) {
+  color: var(--board-ink);
+  letter-spacing: -.025em;
+}
+body.theme-core_design h1 { font-weight: 600; }
+body.theme-core_design :is(h2, h3) { font-weight: 600; }
+body.theme-core_design .op-app-header { border-bottom: 1px solid var(--board-line); }
+body.theme-core_design .op-app-header--start { padding-inline-start: 14px; }
+body.theme-core_design .op-app-header--end { padding-inline-end: 20px; gap: 4px; }
+body.theme-core_design .op-logo--link { filter: brightness(0); opacity: .88; }
+body.theme-core_design[data-color-mode="dark"] .op-logo--link { filter: brightness(0) invert(1); }
+body.theme-core_design .top-menu-search--button {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  color: var(--board-muted);
+}
+body.theme-core_design .op-app-header .top-menu-search .ng-select.ng-select--primerized .ng-select-container {
+  background: var(--board-hover) !important;
+  border: 1px solid transparent;
+  border-color: transparent !important;
+  border-radius: 999px;
+  color: var(--board-ink);
+}
+body.theme-core_design .op-app-header .top-menu-search .ng-select.ng-select-focused .ng-select-container {
+  border-color: var(--board-accent) !important;
+}
+body.theme-core_design .op-app-header .Button--primary {
+  box-shadow: inset 0 2px 0 #ffffff35, 0 1px 2px #00000012;
+}
+body.theme-core_design .main-menu {
+  margin: 12px 0 12px 12px;
+  border: 1px solid var(--board-surface);
+  border-radius: 24px;
+  box-shadow: var(--board-float-shadow);
+  height: calc(100dvh - var(--header-height) - 24px);
+}
+body.theme-core_design .main-menu #menu-sidebar { height: 100%; padding: 0 12px 12px; }
+body.theme-core_design .main-menu .main-menu--top-container { border-color: var(--board-line); }
+body.theme-core_design #main-menu :is(.op-menu--item-action, .op-submenu--item-action) {
+  margin-block: 3px;
+  border: 1px solid transparent;
+  border-left: 1px solid transparent !important;
+  border-radius: 12px;
+  padding-inline-start: 12px;
+  font-weight: 500;
+}
+body.theme-core_design #main-menu :is(.op-menu--item-action, .op-submenu--item-action):hover {
+  background: var(--board-hover);
+  color: var(--board-ink);
+}
+body.theme-core_design #main-menu :is(.op-menu--item-action, .op-submenu--item-action).selected {
+  background: var(--board-accent);
+  color: var(--board-on-accent);
+  border-color: #ffffff40;
+  box-shadow: inset 0 2px 0 #ffffff40, 0 1px 2px #0000000d;
+}
+body.theme-core_design #main-menu :is(.op-menu--item-action, .op-submenu--item-action).selected :is(svg, i) { color: inherit; }
+body.theme-core_design #main-menu .main-menu--segment-header {
+  text-transform: none;
+  color: var(--board-muted);
+  font-size: 12px;
+  font-weight: 500;
+}
+body.theme-core_design .widget-box {
+  border: 1px solid var(--board-line);
+  border-radius: 20px;
+  background: var(--board-surface);
+  box-shadow: 0 1px 1px #0000000d;
+}
+body.theme-core_design .op-widget-box--header { padding: 20px 20px 12px; }
+body.theme-core_design .op-widget-box--header { background: var(--board-surface); }
+body.theme-core_design .op-widget-box--header :is(h2, h3) { font-size: 16px; line-height: 24px; }
+body.theme-core_design .op-widget-box--body { padding: 8px 20px 20px; }
+body.theme-core_design .op-subheader { border-color: var(--board-line); }
+body.theme-core_design :is(.Button, .button, .spot-button) { border-radius: 10px; }
+body.theme-core_design :is(.Button--default, .button:not(.-primary):not(.-danger)) {
+  border-color: var(--board-line);
+  box-shadow: 0 1px 2px #00000008;
+}
+body.theme-core_design :is(.Button--primary, .button.-primary, .spot-button_primary) {
+  background-color: var(--board-accent);
+  border-color: #ffffff40;
+  color: var(--board-on-accent);
+  box-shadow: inset 0 2px 0 #ffffff30, 0 1px 2px #00000012;
+}
+body.theme-core_design :is(.Button--primary, .button.-primary, .spot-button_primary):hover {
+  background-color: var(--board-accent-hover);
+}
+body.theme-core_design :is(.Button, .button, .spot-button):disabled {
+  box-shadow: none;
+  cursor: not-allowed;
+  background: var(--board-ground) !important;
+  border-color: var(--board-line) !important;
+  color: var(--board-muted) !important;
+}
+body.theme-core_design :is(.FormControl-input, .FormControl-select, .FormControl-textarea, .form--text-field, .form--select, .form--text-area, .spot-text-field--input) {
+  border-radius: 10px;
+  border-color: var(--control-borderColor-rest);
+  background-color: var(--board-surface);
+  color: var(--board-ink);
+}
+body.theme-core_design :is(.FormControl-input, .FormControl-select, .FormControl-textarea, .form--text-field, .form--select, .form--text-area):focus {
+  border-color: var(--board-accent);
+  outline: 2px solid var(--board-selected);
+  outline-offset: 1px;
+}
+body.theme-core_design [aria-invalid="true"],
+body.theme-core_design .form--field.-error :is(input, select, textarea) {
+  border-color: var(--fgColor-danger, #d1242f);
+}
+body.theme-core_design :is(.ActionListContent, .TabNav-item, .UnderlineNav-item, .tabnav-tab) {
+  border-radius: 8px;
+}
+body.theme-core_design :is(.Overlay, .SelectMenu-modal, .spot-modal--content, .spot-drop-modal, .dropdown-menu, .ActionMenu .Overlay) {
+  border-radius: 16px;
+  border-color: var(--board-line);
+  box-shadow: var(--board-float-shadow);
+}
+body.theme-core_design :is(.generic-table, .work-packages-table) { font-variant-numeric: tabular-nums; }
+body.theme-core_design :is(.generic-table, .work-packages-table) th {
+  color: var(--board-muted);
+  background: var(--board-ground);
+  border-color: var(--board-line);
+  font-weight: 500;
