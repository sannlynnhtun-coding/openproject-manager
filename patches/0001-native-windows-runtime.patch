diff --git a/script/windows/check.rb b/script/windows/check.rb
new file mode 100644
index 0000000000000000000000000000000000000000..ec3b5410c11f260b0e9fea1dc6ce173601f7d550
--- /dev/null
+++ b/script/windows/check.rb
@@ -0,0 +1,23 @@
+# frozen_string_literal: true
+
+require_relative "../../config/boot"
+require "openssl"
+require "logger"
+require "yabeda/prometheus"
+require "rack/mock"
+
+raise "Run this check on native Windows Ruby" unless Gem.win_platform?
+raise "Unix mmap dependency was activated" if Gem.loaded_specs.key?("prometheus-client-mmap")
+raise "OpenSSL failed" unless OpenSSL::Digest::SHA256.hexdigest("native").size == 64
+
+Yabeda.configure do
+  counter :windows_native_checks, comment: "Native Windows compatibility checks"
+end
+Yabeda.configure!
+Yabeda.windows_native_checks.increment({}, by: 1)
+response = Rack::MockRequest.new(Yabeda::Prometheus::Exporter.rack_app).get("/metrics")
+unless response.status == 200 && response.body.match?(/windows_native_checks(?:_total)? 1(?:\.0)?\b/)
+  raise "Prometheus did not export the counter: #{response.status} #{response.body}"
+end
+
+puts "PASS: native Windows OpenSSL and Prometheus export"
